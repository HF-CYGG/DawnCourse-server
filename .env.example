# Dawn Course server optional runtime configuration.
# Do not put real secrets in files tracked by Git.

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Bundled PostgreSQL defaults can be overridden by deployment tools.
POSTGRES_DB=dawn_course
POSTGRES_USER=dawn
POSTGRES_PASSWORD=

# Public URL used in generated manifests.
PUBLIC_BASE_URL=

# Model configuration can also be edited in the Admin console.
LLM_SUMMARY_PROVIDER=
LLM_SUMMARY_MODEL=
LLM_SUMMARY_API_KEY=
LLM_SUMMARY_BASE_URL=
LLM_SCRIPT_PROVIDER=
LLM_SCRIPT_MODEL=
LLM_SCRIPT_API_KEY=
LLM_SCRIPT_BASE_URL=

# Signing keys are generated automatically under /shared/parsers/keys when absent.
# If you provide a private key manually, use a deployment secret or environment variable.
SCRIPT_SIGN_PRIVATE_KEY=
SCRIPT_VERIFY_PUBLIC_KEY=
