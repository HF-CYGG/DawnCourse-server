# Dawn Course server optional runtime configuration.
# Do not put real secrets in files tracked by Git.

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Bundled PostgreSQL defaults can be overridden by deployment tools.
POSTGRES_DB=dawn_course
POSTGRES_USER=dawn
POSTGRES_PASSWORD=

# Public URL used in generated manifests.
PUBLIC_BASE_URL=

# Model configuration can also be edited in the Admin console.
LLM_SUMMARY_PROVIDER=
LLM_SUMMARY_MODEL=
LLM_SUMMARY_API_KEY=
LLM_SUMMARY_BASE_URL=
LLM_SCRIPT_PROVIDER=
LLM_SCRIPT_MODEL=
LLM_SCRIPT_API_KEY=
LLM_SCRIPT_BASE_URL=

# 脚本签名 / 客户端验签密钥（RSA）。
# 客户端（Android App）内置了固定的验签公钥（见客户端 gradle.properties 的
# SCRIPT_VERIFY_PUBLIC_KEY）。服务端签名用的私钥【必须】是这把公钥的对应私钥，
# 否则 App 会拒绝所有云端脚本并弹「云端脚本拉取失败」。
#
# 当前正确的公钥已随仓库提交在 scripts/script_sign_public.pem，对应私钥不入库。
# 部署时任选其一提供对应私钥：
#   - 设置 SCRIPT_SIGN_PRIVATE_KEY（PEM，可用 \n 转义换行）
#   - 或把 script_sign_private.pem 放到 ${SCRIPT_OUTPUT_DIR:-/shared/parsers}/keys/
# 都不提供时，llm-backend 会在 keys/ 目录【随机生成】一把——此时 App 验签必然失败。
SCRIPT_SIGN_PRIVATE_KEY=
SCRIPT_VERIFY_PUBLIC_KEY=
